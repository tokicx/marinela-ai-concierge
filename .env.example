# Server-only placeholders. Never prefix secrets with NEXT_PUBLIC_.
# Register a separate OAuth callback for local/staging use and set its matching origin here.
SITE_ORIGIN=https://example.com

GOOGLE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key

RESEND_API_KEY=replace-with-server-api-key
BOOKING_EMAIL_FROM="Salon Reservations <reservations@example.com>"
BOOKING_EMAIL_REPLY_TO=salon@example.com
